---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { whyGames, about, experience, education, contact } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order
);
const highlights = projects.filter((project) => project.data.featured).slice(0, 3);
---

<Base>
  <Hero projects={highlights} />

  <section id="why-games" class="section section-story" aria-label="Why games">
    <div class="container-page">
      <SectionHeading number="01" title={whyGames.heading} />
      <div class="story-grid">
        <div class="story-aside" data-reveal>
          <p class="meta story-label">My first two games</p>
          <blockquote class="story-quote display-sm">“{whyGames.pullQuote}”</blockquote>
          <a class="story-link" href="#work">See what I’ve made since ↓</a>
        </div>
        <div class="body-prose">
          {whyGames.paragraphs.map((paragraph, i) => (
            <p class="paragraph" data-reveal data-reveal-index={i}>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="container-page">
      <SectionHeading
        number="02"
        title="Games, experiments & tools"
        lede="Most of my personal projects start with something I want to play or a mechanic I want to try. Here are the games and the tools I’ve built around them."
      />
      <ProjectIndex projects={projects} />
    </div>
  </section>

  <section id="about" class="section section-backend">
    <div class="container-page">
      <SectionHeading number="03" title={about.heading} />
      <div class="body-grid">
        <div class="body-prose">
          {about.paragraphs.map((paragraph, i) => (
            <p class:list={['paragraph', i === 0 && 'paragraph-lead']} data-reveal data-reveal-index={i}>
              {paragraph}
            </p>
          ))}
        </div>
      </div>

      <div id="experience" class="backend-detail">
        <h3 class="subheading display-sm">Professional experience</h3>
        <ol class="roles">
          {experience.map((role, i) => (
            <li class="role" data-reveal data-reveal-index={i}>
              <span class="role-period meta">{role.period}</span>
              <div class="role-body">
                <h4 class="role-title">
                  {role.company}<span class="role-company">{role.role}</span>
                </h4>
                <p class="role-summary">{role.summary}</p>
              </div>
              <span class="role-tech meta">{role.tags.join(', ')}</span>
            </li>
          ))}
        </ol>
      </div>

      <div id="skills" class="backend-detail">
        <h3 class="subheading display-sm">Tools I work with</h3>
        <dl class="spec">
          {about.stack.map((group, i) => (
            <div class="spec-row" data-reveal data-reveal-index={i}>
              <dt class="spec-label meta">{group.area}</dt>
              <dd class="spec-value">{group.items.join(', ')}</dd>
            </div>
          ))}
          {education.map((entry) => (
            <div class="spec-row" data-reveal>
              <dt class="spec-label meta">Education</dt>
              <dd class="spec-value">
                {entry.credential}, {entry.school}
                <span class="spec-note">{entry.detail}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="contact" class="section section-contact">
    <div class="container-page">
      <SectionHeading number="04" title="Get in touch" />
      <div class="contact" data-reveal>
        <p class="contact-pitch">{contact.pitch}</p>
        <a href={`mailto:${contact.email}`} class="contact-email display">{contact.email}</a>
        <ul class="contact-links">
          {contact.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="contact-link">
                <span class="contact-link-label">{link.label}</span>
                <span class="contact-link-handle meta">{link.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-story,
  .section-backend {
    background: var(--paper-sunk);
  }

  .story-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .story-label {
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .story-quote {
    font-size: clamp(1.75rem, 3.1vw, 2.5rem);
    line-height: 1.12;
    max-width: 17ch;
  }

  .story-link {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.3em;
  }

  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 5rem;
      padding-left: 5rem;
    }

    .story-grid .body-prose {
      grid-column: auto;
    }
  }

  .backend-detail {
    margin-top: 3.5rem;
  }

  .subheading {
    font-size: 1.375rem;
  }

  .backend-detail .roles,
  .backend-detail .spec {
    margin-top: 1.25rem;
  }

  .section {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }

  .section-contact {
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }

  /* Shared body grid: content sits in the same column the section titles use. */
  .body-grid {
    display: grid;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .body-grid {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .body-prose {
      grid-column: 2;
    }
  }

  .body-prose {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60ch;
  }

  .paragraph {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  /* Opening paragraph set larger and heavier, so the section has a lead-in
     rather than three identical blocks of text. */
  .paragraph-lead {
    font-size: clamp(1.25rem, 2.3vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 36ch;
  }

  /* Specification table */
  .spec {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .spec-row {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 700px) {
    .spec-row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
    }
  }

  .spec-label {
    padding-top: 0.2rem;
  }

  .spec-value {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .spec-note {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--ink-faint);
  }



  /* Roles */
  .roles {
    list-style: none;
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .role {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .role {
      grid-template-columns: 13rem minmax(0, 1fr) 12rem;
      gap: 2rem;
      align-items: start;
    }
  }

  .role-period {
    padding-top: 0.35rem;
    white-space: nowrap;
  }

  .role-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .role-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .role-company {
    display: block;
    margin-top: 0.4rem;
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink-muted);
  }

  .role-summary {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 48ch;
  }

  .role-tech {
    padding-top: 0.35rem;
    line-height: 1.7;
  }

  /* Contact */
  .contact {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .contact {
      margin-left: 5rem;
    }
  }

  .contact-pitch {
    max-width: 42ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .contact-email {
    font-size: clamp(1.375rem, 4.5vw, 2.875rem);
    color: var(--ink);
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 0.1em;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
    word-break: break-word;
  }

  .contact-email:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 0.5rem;
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-link-label {
    font-size: 1rem;
    font-weight: 500;
    position: relative;
    transition: color 0.2s ease;
  }

  .contact-link-label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .contact-link:hover .contact-link-label {
    color: var(--accent);
  }

  .contact-link:hover .contact-link-label::after,
  .contact-link:focus-visible .contact-link-label::after {
    transform: scaleX(1);
  }
</style>
