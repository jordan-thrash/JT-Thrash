---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <div class="notfound">
    <div class="container-page">
      <span class="meta notfound-code">Error 404</span>
      <h1 class="notfound-title display">This page didn't generate.</h1>
      <p class="notfound-text">
        The link is broken, or it pointed at something on the old site that didn't make the move.
      </p>
      <div class="notfound-actions">
        <a href="/" class="action">Home</a>
        <a href="/#work" class="action">The index</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .notfound {
    padding-block: clamp(4rem, 14vw, 10rem);
  }

  .notfound-code {
    color: var(--accent);
    display: block;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink);
  }

  .notfound-title {
    margin-top: 2.5rem;
    font-size: clamp(2rem, 6.5vw, 4rem);
    max-width: 14ch;
  }

  .notfound-text {
    margin-top: 1.5rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .notfound-actions {
    display: flex;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .action {
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--ink);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .action:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
