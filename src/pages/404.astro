---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <div class="notfound grid-bg">
    <div class="container-page notfound-inner">
      <p class="label">Error 404</p>
      <h1 class="notfound-title">This page didn't generate.</h1>
      <p class="notfound-text">
        The link is broken, or it pointed at something on the old site that didn't make the move.
      </p>
      <div class="notfound-actions">
        <a href="/" class="button-primary">Back home</a>
        <a href="/work" class="button-ghost">Browse the work</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .notfound {
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 4rem;
  }

  .notfound-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .notfound-title {
    font-size: clamp(2rem, 6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .notfound-text {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .button-primary,
  .button-ghost {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.375rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    border: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-out-expo);
  }

  .button-primary {
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }

  .button-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .button-ghost {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .button-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }
</style>
