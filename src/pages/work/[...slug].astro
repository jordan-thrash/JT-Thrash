---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}) satisfies GetStaticPaths;

const { project, projects } = Astro.props;
const { title, summary, discipline, year, tech, links, cover } = project.data;
const { Content } = await render(project);

// Next project in display order, wrapping around, so no page dead-ends.
const ordered = [...projects].sort((a, b) => b.data.order - a.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === project.id);
const next = ordered[(currentIndex + 1) % ordered.length];
const indexNumber = String(currentIndex + 1).padStart(2, '0');
---

<Base title={title} description={summary} path={`/work/${project.id}/`} ogType="article">
  <article>
    <header class="head">
      <div class="container-page">
        <a href="/#work" class="back meta">← Index</a>

        <div class="head-grid">
          <span class="head-number meta">{indexNumber}</span>

          <div>
            <h1 class="head-title display">{title}</h1>
            <p class="head-summary">{summary}</p>
          </div>
        </div>
      </div>
    </header>

    {
      cover && (
        <div class="container-page">
          <figure class="cover">
            <Image
              src={cover}
              alt={`${title} — cover image`}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1248px) 1152px, 92vw"
              loading="eager"
              fetchpriority="high"
              class="cover-image"
            />
          </figure>
        </div>
      )
    }

    <div class="container-page">
      <div class="layout">
        <!-- Specification column: sticky on wide screens so the facts stay put
             while the write-up scrolls past. -->
        <aside class="spec">
          <dl>
            <div class="spec-row">
              <dt class="meta">Discipline</dt>
              <dd>{discipline}</dd>
            </div>
            <div class="spec-row">
              <dt class="meta">Year</dt>
              <dd>{year}</dd>
            </div>
            <div class="spec-row">
              <dt class="meta">Built with</dt>
              <dd>{tech.join(', ')}</dd>
            </div>
          </dl>

          {
            links.length > 0 && (
              <div class="spec-links">
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="spec-link">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            )
          }
        </aside>

        <div class="prose body">
          <Content />
        </div>
      </div>
    </div>

    {
      next && (
        <nav class="next" aria-label="Next project">
          <a href={`/work/${next.id}`} class="next-link">
            <div class="container-page next-inner">
              <span class="meta">Next</span>
              <span class="next-title display">{next.data.title}</span>
              <span class="next-arrow" aria-hidden="true">
                →
              </span>
            </div>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  .back {
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  .head-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 900px) {
    .head-grid {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .head-number {
    color: var(--accent);
    padding-top: 0.5rem;
  }

  .head-title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    max-width: 16ch;
  }

  .head-summary {
    margin-top: 1.25rem;
    max-width: 50ch;
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .cover {
    border: 1px solid var(--rule);
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .layout {
    display: grid;
    gap: 3rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .spec {
      position: sticky;
      top: 6rem;
    }
  }

  .spec-row {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--rule);
  }

  .spec-row:last-of-type {
    border-bottom: 1px solid var(--rule);
  }

  .spec-row dd {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .spec-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .spec-link {
    font-size: 0.9375rem;
    font-weight: 500;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.1rem;
    transition: color 0.2s ease;
  }

  .spec-link:hover {
    color: var(--accent);
  }

  .body {
    max-width: 62ch;
  }

  /* Next project: a full-width band that inverts on hover. */
  .next {
    margin-top: 6rem;
    border-top: 1px solid var(--ink);
  }

  .next-link {
    display: block;
    position: relative;
    overflow: hidden;
    transition: color 0.3s ease;
  }

  .next-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.45s var(--ease-out-expo);
  }

  .next-link:hover,
  .next-link:focus-visible {
    color: var(--paper);
  }

  .next-link:hover::before,
  .next-link:focus-visible::before {
    transform: scaleY(1);
  }

  .next-inner {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .next-title {
    font-size: clamp(1.75rem, 5vw, 3.5rem);
    flex: 1;
  }

  .next-arrow {
    font-size: 1.5rem;
    transition: translate 0.35s var(--ease-out-expo);
  }

  .next-link:hover .next-arrow {
    translate: 0.5rem 0;
  }
</style>
