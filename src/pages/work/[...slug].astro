---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}) satisfies GetStaticPaths;

const { project, projects } = Astro.props;
const { title, summary, kind, year, tech, links, cover } = project.data;
const { Content } = await render(project);

// Next two projects in display order, wrapping around, so every page has a
// forward path rather than dead-ending.
const ordered = [...projects].sort((a, b) => b.data.order - a.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === project.id);
const more = [
  ordered[(currentIndex + 1) % ordered.length],
  ordered[(currentIndex + 2) % ordered.length],
].filter((entry) => entry && entry.id !== project.id);
---

<Base title={title} description={summary} path={`/work/${project.id}/`} ogType="article">
  <article class="project">
    <header class="project-header">
      <div class="container-page">
        <a href="/#work" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          All work
        </a>

        <div class="project-meta label">
          <span class="project-kind">{kind}</span>
          <span aria-hidden="true">·</span>
          <span>{year}</span>
        </div>

        <h1 class="project-title">{title}</h1>
        <p class="project-summary">{summary}</p>

        <ul class="project-tech" aria-label="Built with">
          {tech.map((item) => <li>{item}</li>)}
        </ul>

        {
          links.length > 0 && (
            <div class="project-links">
              {links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="project-link">
                  {link.label}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {
      cover && (
        <div class="container-page">
          <figure class="project-cover">
            <Image
              src={cover}
              alt={`${title} cover image`}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1152px) 1088px, 92vw"
              loading="eager"
              fetchpriority="high"
              class="project-cover-image"
              style={`view-transition-name: cover-${project.id}`}
            />
          </figure>
        </div>
      )
    }

    <div class="container-page">
      <div class="prose project-body">
        <Content />
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="more">
        <div class="container-page">
          <h2 class="label more-label">Next</h2>
          <div class="more-grid">
            {more.map((entry, index) => (
              <ProjectCard project={entry} revealIndex={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .project-header {
    padding-top: 8rem;
    padding-bottom: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .back-link svg {
    width: 14px;
    height: 14px;
    transition: translate 0.25s var(--ease-out-expo);
  }

  .back-link:hover svg {
    translate: -3px 0;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
  }

  .project-kind {
    color: var(--accent);
  }

  .project-title {
    margin-top: 0.875rem;
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--fg);
  }

  .project-summary {
    margin-top: 1.25rem;
    max-width: 44rem;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .project-tech li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.25rem 0.55rem;
    background: var(--surface);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.5rem;
    padding-inline: 1.1rem;
    border-radius: 0.625rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 0.25s ease,
      transform 0.25s var(--ease-out-expo);
  }

  .project-link:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .project-link svg {
    width: 14px;
    height: 14px;
  }

  .project-cover {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .project-cover-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .project-body {
    max-width: 44rem;
    margin-top: 3.5rem;
  }

  .more {
    margin-top: 6rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .more-label {
    margin-bottom: 1.5rem;
  }

  .more-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
