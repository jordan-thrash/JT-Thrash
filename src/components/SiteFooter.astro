---
import { site, contact } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container-page">
    <div class="footer-inner meta">
      <span>&copy; {year} {site.name}</span>
      <span class="footer-links">
        {
          contact.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="footer-link">
              {link.label}
            </a>
          ))
        }
        <a href={`mailto:${contact.email}`} class="footer-link">Email</a>
      </span>
      <span class="footer-colophon">Astro · Netlify</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--ink);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-link {
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-colophon {
    color: var(--ink-faint);
  }
</style>
