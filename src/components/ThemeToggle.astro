---
// Both icons are always in the DOM and cross-fade with CSS, so switching the
// theme causes no layout shift and needs no re-render.
---

<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch colour theme">
  <span class="icon-stack">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-moon"
      aria-hidden="true"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      class="icon icon-sun"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path>
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .icon-stack {
    position: relative;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
  }

  .icon {
    position: absolute;
    width: 18px;
    height: 18px;
    transition:
      opacity 0.35s ease,
      rotate 0.45s var(--ease-spring),
      scale 0.45s var(--ease-spring);
  }

  .icon-sun {
    opacity: 0;
    rotate: -90deg;
    scale: 0.4;
  }

  :root[data-theme='light'] .icon-moon {
    opacity: 0;
    rotate: 90deg;
    scale: 0.4;
  }

  :root[data-theme='light'] .icon-sun {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');

  const apply = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      // Storage can be unavailable (private mode, blocked cookies). The theme
      // still applies to this page view, it just will not persist.
    }
  };

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduceMotion && typeof document.startViewTransition === 'function') {
      document.startViewTransition(() => apply(next));
    } else {
      apply(next);
    }
  });

  // Follow the OS setting only while the visitor has not made an explicit choice.
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('theme')) return;
    } catch {
      return;
    }
    document.documentElement.dataset.theme = event.matches ? 'light' : 'dark';
  });
</script>
