---
import { site, nav } from '../data/site';
---

<header class="header">
  <div class="container-page header-inner">
    <a href="/" class="brand">
      <span class="brand-name">{site.name}</span>
      <span class="brand-role meta">{site.role}</span>
    </a>

    <nav aria-label="Primary" class="nav">
      {
        nav.map((item) => (
          <a href={item.href} class="nav-link meta">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* Sticky, not fixed: the page pushes it, so there is no floating bar
     hovering over the content and no backdrop blur to fake separation. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.125rem;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .brand-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-role {
    display: none;
  }

  @media (min-width: 640px) {
    .brand-role {
      display: inline;
    }
  }

  .nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--ink-muted);
    padding-block: 0.25rem;
    transition: color 0.2s ease;
    position: relative;
  }

  /* Rule grows from the left on hover rather than a pill or a background. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out-expo);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--accent);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* The nav is four short words. Below 480px they wrap to a second line, which
     is fine and much better than hiding them behind a hamburger. */
  @media (max-width: 479px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.625rem;
    }

    .nav {
      gap: 1.125rem;
    }
  }
</style>
