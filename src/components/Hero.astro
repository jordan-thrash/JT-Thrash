---
import { hero, contact } from '../data/site';

interface Props {
  /** Year span of the work in the index, e.g. "2019—2024". */
  range?: string;
}

const { range } = Astro.props;
---

<section class="hero">
  <div class="container-page">
    {/* Running metadata. Deliberately does not repeat the name or the role —
        the site header already carries both, one line above this. */}
    <div class="masthead meta">
      <span>Selected work</span>
      {range && <span class="masthead-range">{range}</span>}
      <span class="masthead-spacer"></span>
      <span class="masthead-tail">{hero.spec}</span>
    </div>

    <h1 class="hero-headline display">
      {
        hero.headline.map((line) => (
          <span class="hero-line">
            <span class="hero-line-inner" set:html={line} />
          </span>
        ))
      }
    </h1>

    <div class="hero-foot">
      <p class="hero-lede">{hero.lede}</p>

      <div class="hero-actions">
        <a href="#work" class="action">
          The index
          <span class="action-rule" aria-hidden="true"></span>
        </a>
        <a href={`mailto:${contact.email}`} class="action">
          Email
          <span class="action-rule" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .masthead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
  }

  .masthead-range {
    color: var(--ink-faint);
  }

  .masthead-spacer {
    flex: 1;
  }

  .masthead-tail {
    color: var(--ink-faint);
    display: none;
  }

  @media (min-width: 768px) {
    .masthead-tail {
      display: inline;
    }
  }

  .hero-headline {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    /* Big. This is the one place on the site where type is the entire design. */
    font-size: clamp(2.75rem, 10vw, 8.5rem);
    max-width: 13ch;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-line-inner {
    display: block;
    animation: line-rise 1.05s var(--ease-out-expo) both;
  }

  .hero-line:nth-child(2) .hero-line-inner {
    animation-delay: 0.09s;
  }

  .hero-line:nth-child(3) .hero-line-inner {
    animation-delay: 0.18s;
  }

  /* Emphasis inside the headline, marked up in the data file. Color alone —
     an italic at this width and weight fights the rest of the line. */
  .hero-headline :global(em) {
    font-style: normal;
    color: var(--accent);
  }

  .hero-foot {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    animation: fade-in 0.9s var(--ease-out-expo) 0.4s both;
  }

  @media (min-width: 900px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 4rem;
    }
  }

  .hero-lede {
    max-width: 46ch;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    gap: 2rem;
  }

  /* Text links with a rule underneath, not buttons. */
  .action {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    padding-bottom: 0.4rem;
    white-space: nowrap;
  }

  .action-rule {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--ink);
  }

  .action-rule::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .action:hover {
    color: var(--accent);
  }

  .action:hover .action-rule::after,
  .action:focus-visible .action-rule::after {
    transform: scaleX(1);
  }

  @keyframes line-rise {
    from {
      transform: translateY(102%);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-inner,
    .hero-foot {
      animation: none;
    }
  }
</style>
