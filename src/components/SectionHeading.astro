---
interface Props {
  /** Small monospace label above the title, e.g. "01 — Work". */
  eyebrow: string;
  title: string;
  /** Optional supporting sentence beneath the title. */
  lede?: string;
  align?: 'start' | 'center';
}

const { eyebrow, title, lede, align = 'start' } = Astro.props;
---

<header
  class:list={['heading', align === 'center' && 'heading-center']}
  data-reveal
>
  <p class="label heading-eyebrow">
    <span class="heading-rule" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 class="heading-title">{title}</h2>
  {lede && <p class="heading-lede">{lede}</p>}
</header>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 46rem;
  }

  .heading-center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .heading-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .heading-rule {
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .heading-title {
    font-size: clamp(1.875rem, 4.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--fg);
  }

  .heading-lede {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }
</style>
