---
interface Props {
  /** Section number, e.g. "01". Rendered in the left margin on wide screens. */
  number: string;
  title: string;
  lede?: string;
}

const { number, title, lede } = Astro.props;
---

<header class="heading" data-reveal>
  <span class="heading-number meta">{number}</span>
  <div class="heading-body">
    <h2 class="heading-title display">{title}</h2>
    {lede && <p class="heading-lede">{lede}</p>}
  </div>
</header>

<style>
  /* Numbers hang in the left margin, the way a printed index would set them. */
  .heading {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 900px) {
    .heading {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .heading-number {
    color: var(--accent);
    padding-top: 0.35rem;
  }

  .heading-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .heading-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    max-width: 20ch;
  }

  .heading-lede {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }
</style>
