---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="highlights" aria-label="A few of my games">
  {projects.map((project) => (
    <a class="highlight" href={`/work/${project.id}`}>
      {project.data.cover && (
        <div class="highlight-image">
          <Image
            src={project.data.cover}
            alt=""
            widths={[320, 640, 960]}
            sizes="(min-width: 900px) 368px, (min-width: 600px) 30vw, 90vw"
            loading="eager"
          />
        </div>
      )}
      <div class="highlight-caption">
        <div>
          <h2>{project.data.title}</h2>
          <p>{project.data.discipline}</p>
        </div>
        <span class="highlight-arrow" aria-hidden="true">↗</span>
      </div>
    </a>
  ))}
</section>

<style>
  .highlights {
    display: grid;
    gap: 1.75rem;
    margin-top: 3rem;
  }

  @media (min-width: 600px) {
    .highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .highlight {
    min-width: 0;
  }

  .highlight-image {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    transition: border-color 0.2s ease;
  }

  .highlight-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .highlight-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.875rem;
  }

  h2 {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  p {
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .highlight-arrow {
    color: var(--accent);
    transition: translate 0.2s ease;
  }

  .highlight:hover .highlight-image,
  .highlight:focus-visible .highlight-image {
    border-color: var(--accent);
  }

  .highlight:hover h2 {
    color: var(--accent);
  }

  .highlight:hover .highlight-arrow {
    translate: 0.15rem -0.15rem;
  }
</style>
