---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, contact, experience } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Set on project pages so the canonical/OG URL points at the article. */
  path?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(path, Astro.site ?? Astro.url).toString();
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).toString();

// Current employer for structured data: the first role with no end date.
const currentRole = experience.find((role) => role.end === null);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${contact.email}`,
  ...(currentRole ? { worksFor: { '@type': 'Organization', name: currentRole.company } } : {}),
  sameAs: contact.links.map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f5f1" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Gates the scroll-reveal CSS: without JS, nothing is ever hidden. */}
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
      }

      .skip:focus {
        left: 1rem;
        top: 1rem;
        z-index: 100;
        position: fixed;
        background: var(--accent);
        color: var(--paper);
        padding: 0.6rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
      }
    </style>

    <script>
      // Scroll reveal. Targets are only hidden once `js-reveal` is on the
      // documentElement, so this failing leaves the page fully readable.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        targets.forEach((el, i) => {
          // Stagger siblings so index rows cascade instead of popping in at once.
          const index = Number(el.dataset.revealIndex ?? i % 6);
          el.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 45}ms`);
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
